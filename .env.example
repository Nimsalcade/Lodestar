# ---- AI analyst (DeepSeek) ----------------------------------------------
# auto (default): use DEEPSEEK_API_KEY if it is a real key, otherwise a local
# Ollama if one is listening, otherwise answer from deterministic templates.
# Check whatever you configure with:  python scripts/check_agent.py
LLM_PROVIDER=auto

# deploy: hosted DeepSeek API (provide the key)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-flash          # or deepseek-v4-pro

# local: Ollama (install from ollama.com, then `ollama pull deepseek-r1:14b`)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1   # in docker compose: http://ollama:11434/v1
# OLLAMA_MODEL=deepseek-r1:14b                # deepseek-r1:8b on 16 GB machines

# any OpenAI-compatible DeepSeek server (vLLM, llama.cpp, LM Studio)
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT=90

# ---- live results ---------------------------------------------------------
LIVE_SOURCE=none            # none | civicapi | demo
LIVE_POLL_SECONDS=30        # civicAPI refresh interval
CIVICAPI_TIMEOUT=20         # per-request timeout, seconds
CIVICAPI_RETRIES=3          # retries with backoff on transient failures
LIVE_STALE_SECONDS=90       # /api/live flags itself stale after this long
# LIVE_STATE_PATH=/app/output/live_state.json   # results survive a restart
