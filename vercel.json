{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "lodestar": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": { "service": "lodestar" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "lodestar" }
    }
  ]
}
